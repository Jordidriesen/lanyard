{
	"name": "lanyard",
	"version": "2.2.0",
	"private": true,
	"description": "Server-rendered business card block with ACF sources and theme.json styling. Fork of Business Card Block 2.1.7 by bPlugins.",
	"license": "GPL-3.0-or-later",
	"scripts": {
		"build": "wp-scripts build --webpack-copy-php",
		"start": "wp-scripts start --webpack-copy-php",
		"lint:js": "wp-scripts lint-js src",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"lint:php-syntax": "node tools/php-syntax-check.js lanyard.php uninstall.php includes src",
		"test:unit": "node --test \"tools/*.test.mjs\"",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"files": [
		"lanyard.php",
		"uninstall.php",
		"readme.txt",
		"includes",
		"build",
		"languages"
	],
	"devDependencies": {
		"@wordpress/scripts": "36.1.0",
		"php-parser": "3.7.0"
	}
}
