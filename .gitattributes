# Normalise line endings in the repository; check out with the platform default.
* text=auto eol=lf

*.php    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.scss   text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf

*.png    binary
*.jpg    binary
*.zip    binary

# Left out of "git archive" release exports
/.github          export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore
/tools            export-ignore
